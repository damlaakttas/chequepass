rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() { return request.auth != null; }
    function isUser(uid) { return isAuth() && request.auth.uid == uid; }

    match /users/{uid} {
      allow read:   if isAuth();
      allow create: if isUser(uid);
      allow update: if isUser(uid);
      allow delete: if false;
    }

    match /matches/{matchId} {
      allow read:   if isAuth() && request.auth.uid in resource.data.participants;
      allow create: if isAuth() && request.auth.uid in request.resource.data.participants;
      allow update: if isAuth() && request.auth.uid in resource.data.participants;
      allow delete: if false;
    }

    match /friendRequests/{reqId} {
      allow read:   if isAuth() && (resource.data.fromUserId == request.auth.uid || resource.data.toUserId == request.auth.uid);
      allow create: if isAuth() && request.resource.data.fromUserId == request.auth.uid;
      allow update: if isAuth() && resource.data.toUserId == request.auth.uid;
      allow delete: if false;
    }

    match /coupons/{couponId} {
      allow read: if isAuth() && (
        resource.data.winnerId == request.auth.uid ||
        resource.data.giverId  == request.auth.uid ||
        resource.data.recipientId == request.auth.uid
      );
      allow create: if isAuth() && (
        request.resource.data.winnerId == request.auth.uid ||
        request.resource.data.giverId  == request.auth.uid
      );
      allow update: if isAuth() && (
        resource.data.winnerId == request.auth.uid ||
        resource.data.recipientId == request.auth.uid
      );
      allow delete: if false;
    }

    match /couponTemplates/{templateId} {
      allow read:  if isAuth();
      allow write: if false;
    }

    match /notifications/{notifId} {
      allow read:   if isAuth() && resource.data.toUserId == request.auth.uid;
      allow create: if isAuth() && request.resource.data.fromUserId == request.auth.uid;
      allow update: if isAuth() && resource.data.toUserId == request.auth.uid;
      allow delete: if isAuth() && resource.data.toUserId == request.auth.uid;
    }
  }
}

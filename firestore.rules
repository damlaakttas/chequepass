rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() { return request.auth != null; }
    function isUser(uid) { return isAuth() && request.auth.uid == uid; }

    // --- Users ---
    match /users/{uid} {
      allow read:   if isAuth();
      allow create: if isUser(uid);
      allow update: if isUser(uid);
      // Hesap silme (Apple 5.1.1(v)): kullanıcı kendi profilini silebilir
      allow delete: if isUser(uid);
    }

    // --- Usernames ---
    //
    // Kullanıcı adı iki aşamalı:
    //   1) Kayıt anında REZERVASYON yazılır  → verified:false, claimedAt:now
    //   2) E-posta doğrulanıp giriş yapılınca → verified:true (kalıcı)
    //
    // 30 dakika içinde doğrulanmayan rezervasyonlar başkası tarafından
    // devralınabilir. Böylece hatalı e-postayla yapılan kayıt (ör. .con)
    // kullanıcı adını kilitlemez.
    match /usernames/{username} {
      allow read:   if true;
      allow create: if isAuth() && request.resource.data.uid == request.auth.uid;

      allow update: if isAuth()
        && request.resource.data.uid == request.auth.uid
        && (
          // Kendi kaydın (doğrulama işaretleme, tekrar deneme)
          resource.data.uid == request.auth.uid
          ||
          // Başkasının doğrulanmamış ve süresi dolmuş rezervasyonunu devralma.
          // claimedAt yoksa devralınamaz (eski kayıtlar korunur).
          (
            resource.data.get('verified', false) != true &&
            resource.data.get('claimedAt', request.time) < request.time - duration.value(30, 'm')
          )
        );

      // Hesap silme: kullanıcı sadece kendi username kaydını silebilir
      allow delete: if isAuth() && resource.data.uid == request.auth.uid;
    }

    // --- Friendships ---
    match /friendships/{fid} {
      allow get:    if isAuth() && (resource == null || request.auth.uid in resource.data.userIds);
      allow list:   if isAuth();
      allow create: if isAuth() && request.auth.uid in request.resource.data.userIds;
      allow update: if isAuth() && request.auth.uid in resource.data.userIds;
      allow delete: if isAuth() && request.auth.uid in resource.data.userIds;
    }

    // --- Cheques ---
    match /cheques/{cid} {
      allow get:    if isAuth() && (resource == null || request.auth.uid in resource.data.participants);
      allow list:   if isAuth();
      allow create: if isAuth() && request.auth.uid in request.resource.data.participants;

      // Güncelleme sahibine ait. Ek kural: SÜRESİ DOLMUŞ bir çek
      // "kullanıldı" olarak işaretlenemez. expiresAt alanı olmayan
      // eski çekler süresizdir, onlarda kısıt yok.
      allow update: if isAuth()
        && request.auth.uid == resource.data.ownerId
        && (
          request.resource.data.status != 'used'
          || resource.data.get('expiresAt', request.time + duration.value(1, 's')) > request.time
        );
      // Silme:
      // - Sahibi, kullanılmış çeki silebilir (mevcut davranış)
      // - Hesap silme akışı: katılımcı olduğu tüm çekleri silebilir
      allow delete: if isAuth() && request.auth.uid in resource.data.participants;
    }

    // --- Decks (kart şablonları, herkes okur, sadece admin yazar) ---
    match /decks/{deckId} {
      allow read: if isAuth();
      allow write: if false; // Sadece backend (Admin SDK) yazabilir

      match /cards/{cardId} {
        allow read: if isAuth();
        allow write: if false;
      }
    }
  }
}

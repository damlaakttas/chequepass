{
  "expo": {
    "name": "ChequePass",
    "slug": "chequepass",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/amblem.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/amblem.png",
      "resizeMode": "contain",
      "backgroundColor": "#f0e9e9"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.damlaaktas.chequepass",
      "buildNumber": "1"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/amblem.png",
        "backgroundColor": "#f0e9e9"
      },
      "package": "com.chequepass.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-font",
        {
          "fonts": []
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "81fc144f-f955-471b-9b71-42208a22f9c1"
      }
    },
    "owner": "damlaaktassss"
  }
}
